# ========================================
# DataInsight Demo Configuration
# ========================================

# LLM Configuration (Required)
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Model Configuration (Required)
# DEFAULT_MODEL: Main model for chat and analysis
DEFAULT_MODEL=your-model-name

# MEMORY_MODEL: Model for memory extraction (optional, defaults to DEFAULT_MODEL)
# Can use a smaller/cheaper model for memory tasks
MEMORY_MODEL=

# Available Models for UI selector (comma separated)
AVAILABLE_MODELS=model1,model2,model3

# Application Settings
DEBUG=True
SECRET_KEY=your-secret-key-here
HOST=0.0.0.0
PORT=8050

# Note: This demo uses SQLite database (data/database.db)
